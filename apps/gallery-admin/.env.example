# These values are public browser configuration, not secrets. Copy this file to
# .env.local and fill the Cognito values from `terraform output` after applying
# the authentication foundation.
VITE_GALLERY_API_URL=https://m02dauw9h9.execute-api.eu-central-1.amazonaws.com
VITE_COGNITO_AUTHORITY=https://cognito-idp.eu-central-1.amazonaws.com/USER_POOL_ID
VITE_COGNITO_CLIENT_ID=COGNITO_APP_CLIENT_ID
VITE_COGNITO_DOMAIN=https://YOUR_COGNITO_DOMAIN.auth.eu-central-1.amazoncognito.com
VITE_COGNITO_SCOPES="openid email profile gallery/read gallery/write gallery/publish"
